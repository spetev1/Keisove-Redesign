#!/bin/bash
# Expose the local Keisove demo over a Cloudflare tunnel.
#
# Serves the *built* assets deliberately: Vite's dev server advertises a
# localhost origin for HMR, which is unreachable for anyone on the far side of
# the tunnel, so the page would load unstyled. Build first, then share.
#
#   ./share            quick tunnel, random *.trycloudflare.com URL
#   ./share <hostname> named tunnel on a domain you control (stable URL)
{
set -eo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"

CLOUDFLARED="${CLOUDFLARED:-$HOME/cloudflared}"
LOG="/tmp/keisove-tunnel.log"
HOSTNAME_ARG="${1:-}"

if [ ! -x "$CLOUDFLARED" ]; then
    echo "cloudflared not found or not executable at $CLOUDFLARED"
    echo "Set CLOUDFLARED=/path/to/cloudflared, or chmod +x it."
    exit 1
fi

APP_PORT="$(sed -n 's/^APP_PORT=//p' .env | head -1)"
APP_PORT="${APP_PORT:-80}"

# ============================================
#  Restore local config on exit, however we exit.
# ============================================
restore_env() {
    echo ""
    echo "Restoring local configuration..."
    sed -i 's|^TUNNEL_ACTIVE=.*|TUNNEL_ACTIVE=false|' .env
    sed -i "s|^APP_URL=.*|APP_URL=http://localhost:${APP_PORT}|" .env
    ./sail artisan config:clear >/dev/null 2>&1 || true
    echo "Done. Local app is back on http://localhost:${APP_PORT}"
}
trap restore_env EXIT

# ============================================
#  Phase 1: containers + assets
# ============================================
echo "--- 1/3: Starting containers ---"
./sail up -d >/dev/null 2>&1
echo "  containers up"

echo "--- 2/3: Building assets ---"
./sail yarn build > "$LOG" 2>&1 && echo "  build ok" || {
    echo "  build FAILED (see $LOG)"; exit 1;
}

if [ ! -s "public/build/manifest.json" ]; then
    echo "  build verification FAILED: public/build/manifest.json missing or empty"
    exit 1
fi

# ============================================
#  Phase 2: tell Laravel it is behind a proxy
# ============================================
grep -q '^TUNNEL_ACTIVE=' .env || echo "TUNNEL_ACTIVE=false" >> .env
sed -i 's|^TUNNEL_ACTIVE=.*|TUNNEL_ACTIVE=true|' .env

echo "--- 3/3: Opening tunnel ---"

if [ -n "$HOSTNAME_ARG" ]; then
    # Named tunnel: stable URL, requires a one-time `cloudflared tunnel login`
    # and a DNS route for the hostname.
    sed -i "s|^APP_URL=.*|APP_URL=https://${HOSTNAME_ARG}|" .env
    ./sail artisan config:clear >/dev/null 2>&1 || true

    echo ""
    echo "==========================================="
    echo "  https://${HOSTNAME_ARG}"
    echo "==========================================="
    echo "Ctrl-C to stop sharing."
    echo ""

    "$CLOUDFLARED" tunnel --url "http://localhost:${APP_PORT}" \
        --hostname "$HOSTNAME_ARG"
    exit 0
fi

# Quick tunnel: no account needed, but the URL is random and changes every run.
# cloudflared prints it to stderr a second or two after start, so we tee the
# output and scrape it rather than making the user hunt for it.
rm -f "$LOG.tunnel"
"$CLOUDFLARED" tunnel --url "http://localhost:${APP_PORT}" > "$LOG.tunnel" 2>&1 &
TUNNEL_PID=$!
trap 'kill $TUNNEL_PID 2>/dev/null || true; restore_env' EXIT

PUBLIC_URL=""
for _ in $(seq 1 30); do
    PUBLIC_URL="$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$LOG.tunnel" | head -1 || true)"
    [ -n "$PUBLIC_URL" ] && break
    sleep 1
done

if [ -z "$PUBLIC_URL" ]; then
    echo "  Tunnel did not report a URL in 30s (see $LOG.tunnel)"
    exit 1
fi

sed -i "s|^APP_URL=.*|APP_URL=${PUBLIC_URL}|" .env
./sail artisan config:clear >/dev/null 2>&1 || true

echo ""
echo "==========================================="
echo "  $PUBLIC_URL"
echo "==========================================="
DEMO_PASSWORD="$(sed -n 's/^DEMO_PASSWORD=//p' .env | head -1)"
if [ -n "$DEMO_PASSWORD" ]; then
    echo "  Password: $DEMO_PASSWORD"
else
    echo "  WARNING: DEMO_PASSWORD is empty — the demo is open to anyone"
    echo "  with the link. Set it in .env before sending this to a client."
fi
echo ""
echo "  This link only works while this terminal stays open"
echo "  and this machine is awake."
echo ""
echo "Ctrl-C to stop sharing."

wait $TUNNEL_PID
}
